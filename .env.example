# =============================================================================
# .env.example — copy this to .env (same folder) and fill it in.
#
# .env is gitignored and must never be committed. These same variables also
# have to exist in the Netlify dashboard (Site configuration → Environment
# variables): the two do not talk to each other.
# =============================================================================

# ---------- Database (Supabase) ----------
# A password with @ : / ? # breaks the URL — use percent-encoding (# -> %23, @ -> %40).
# Direct connection: port 5432, host db.<ref>.supabase.co
# Pooler (preferred in serverless): port 6543, host ...pooler.supabase.com, user <user>.<ref>

# What the AGENT uses: the read-only user, with SELECT only on the two views.
# Created by db/04_role.sql — scripts/db_setup.py prints this line for you.
SUPABASE_DB_URL=postgresql://analytics_agent:<password>@<host>:<port>/postgres

# What the SETUP SCRIPTS use: an administrator (`postgres` on Supabase), only to
# create the schema, the data, the views and the read-only user. The agent never
# sees this one.
SUPABASE_DB_ADMIN_URL=postgresql://postgres:<password>@<host>:5432/postgres

# The password given to the read-only user by db/04_role.sql. Pick a strong one.
AGENT_DB_PASSWORD=

# ---------- AI model ----------
OPENAI_API_KEY=
# Optional: swaps the model without touching the code.
OPENAI_MODEL=

# ---------- Meta Cloud API (WhatsApp) ----------
# A secret phrase YOU make up and repeat in Meta's webhook dashboard.
WHATSAPP_VERIFY_TOKEN=
# A SYSTEM USER token (Business Manager), with whatsapp_business_messaging and
# whatsapp_business_management. Not the temporary one from the "Try it" screen.
WHATSAPP_ACCESS_TOKEN=
# IDs from the "Step 1. Try it" screen in Meta for Developers.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Your number in international format without the + (e.g. 5511999999999).
MY_NUMBER=

# ---------- Optional, recommended in production ----------
# The App Secret of the app on Meta. Validates that the POST really came from Meta.
WHATSAPP_APP_SECRET=
